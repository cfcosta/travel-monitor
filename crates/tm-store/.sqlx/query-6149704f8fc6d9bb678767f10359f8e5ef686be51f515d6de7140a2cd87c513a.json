  "query": "SELECT e.currency, e.brl_per_unit, e.at AS \"at: DateTime<Utc>\"\n               FROM exchange_rates e\n               WHERE e.id = (SELECT x.id FROM exchange_rates x\n                             WHERE x.currency = e.currency\n                             ORDER BY x.at DESC, x.id DESC LIMIT 1)\n               ORDER BY e.currency",
